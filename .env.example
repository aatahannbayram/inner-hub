# Shared
NODE_ENV=development
PORT=3001
APP_URL=https://inner.digital
# www.inner.digital CORS’ta otomatik izinli (APP_URL’den türetilir). Canonical apex kalsın.

# Required
DATABASE_URL=postgresql://user:pass@host:5432/inner_hub
ADMIN_PASSCODE=
# Panel kayıt / Google ile yeni hesap — opsiyonel master kod (acil).
# Asıl akış: admin onayında kişiye özel kod üretilir ve mailde gider.
INVITE_PASSCODE=

# Higgsfield
HF_API_KEY=
HF_API_SECRET=

# Üyelik talebi mailleri (Hostinger SMTP) — boş bırakılırsa mail gönderilmez
# Deliverability: SPF (var) + DKIM (hPanel Enable) + DMARC (_dmarc TXT).
# MAIL_FROM = SMTP_USER = @inner.digital mailbox. Onayda kişiye özel kod üretilir.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@inner.digital
SMTP_PASS=
NOTIFY_EMAIL=hey@inner.digital
MAIL_FROM=noreply@inner.digital
MAIL_FROM_NAME=inner hub
MAIL_REPLY_TO=support@inner.digital

# Frontend (Vite build-time) — Google Analytics 4
# Admin → GA4 → Veri akışları → Ölçüm kimliği (G-XXXXXXXXXX)
# Hostinger’da build env’ine de aynı anahtarı koy; yoksa GA yüklenmez.
VITE_GA_MEASUREMENT_ID=

# Optional integrations
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ANNUAL=
# STRIPE_PRICE_FOUNDER=
# ANTHROPIC_API_KEY=

# Vault dosya deposu (varsayılan: ./data/vault)
# VAULT_STORAGE_DIR=/var/data/inner-hub/vault
