# Shared
NODE_ENV=development
PORT=3001
APP_URL=https://inner.digital
# www.inner.digital CORS’ta otomatik izinli (APP_URL’den türetilir). Canonical apex kalsın.

# Required
DATABASE_URL=postgresql://user:pass@host:5432/inner_hub
ADMIN_PASSCODE=
# Panel kayıt / Google ile yeni hesap — opsiyonel master kod (acil).
# Asıl akış: admin onayında kişiye özel kod üretilir ve mailde gider.
INVITE_PASSCODE=

# Higgsfield
HF_API_KEY=
HF_API_SECRET=

# Mux (ders videosu barındırma) — dashboard.mux.com → Settings → Access Tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Üyelik / transactional mailler
# Giden: Resend — From noreply@mail.inner.digital. Gelen/MX: Hostinger apex.
# DNS: Hostinger zone (NS Hostinger). Resend domain: mail.inner.digital · Receiving kapalı.
RESEND_API_KEY=
# Gönderim domain: mail.inner.digital (Resend verified). Gelen kutu/MX: apex Hostinger.
# Opsiyonel: RESEND_FROM="inner hub <noreply@mail.inner.digital>"
MAIL_FROM=noreply@mail.inner.digital
MAIL_FROM_NAME=inner hub
MAIL_REPLY_TO=support@inner.digital
NOTIFY_EMAIL=hey@inner.digital

# Fallback (RESEND_API_KEY yoksa) — Hostinger SMTP (apex mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@inner.digital
SMTP_PASS=

# Frontend (Vite build-time) — Google Analytics 4
# Admin → GA4 → Veri akışları → Ölçüm kimliği
VITE_GA_MEASUREMENT_ID=G-FGLJ0ECVDD
# API tarafı (aynı ID; panel “Google’a gönderiliyor” rozeti)
GA_MEASUREMENT_ID=G-FGLJ0ECVDD

# Opsiyonel: Admin Analytics paneli GA4 Data API ile senkron (Framer’daki “Google” kaynağı)
# GA4 → Yönetici → Mülk ayarları → Mülk kimliği (sayısal)
# GA4_PROPERTY_ID=123456789
# Service account (Analytics Readonly) JSON’dan:
# GA4_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Service account e-postasını GA4 mülküne Viewer olarak ekle.

# Optional integrations
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ANNUAL=
# STRIPE_PRICE_FOUNDER=
# ANTHROPIC_API_KEY=
# Product Hunt GraphQL (Stage PH oy senkronu, read-only developer/client token)
# PRODUCT_HUNT_TOKEN=

# Google ile giriş (panel login) — console.cloud.google.com → OAuth client ID
# GOOGLE_CLIENT_ID=

# LinkedIn ile bağlan (Profil > Sosyal linkler) — linkedin.com/developers → app oluştur,
# "Sign In with LinkedIn using OpenID Connect" ürününü ekle.
# Redirect URL: {APP_URL}/api/auth/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Vault dosya deposu (varsayılan: ./data/vault)
# VAULT_STORAGE_DIR=/var/data/inner-hub/vault
